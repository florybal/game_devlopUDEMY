build glew_build/CMakeFiles/glew.dir/__/__/src/glew.c.o: C_COMPILER__glew_Debug /home/florybal/cursos/game_development/2/thirdparty/glew/src/glew.c || cmake_object_order_depends_target_glew
  DEFINES = -DGLEW_BUILD -DGLEW_NO_GLU -Dglew_EXPORTS
  DEP_FILE = glew_build/CMakeFiles/glew.dir/__/__/src/glew.c.o.d
  FLAGS = -g -fPIC
  INCLUDES = -I/home/florybal/cursos/game_development/2/source -I/home/florybal/cursos/game_development/2/thirdparty/glfw-3.4/inlcude -I/home/florybal/cursos/game_development/2/thirdparty/glew/build/cmake/../../include
